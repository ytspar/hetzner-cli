# Hetzner Robot API Credentials
# Get these from: https://robot.hetzner.com/preferences/index
# Navigate to: Settings > Web service settings > Create new user
#
# Note: This is for the Robot API (dedicated servers), NOT Hetzner Cloud.
# The web service user is separate from your main Hetzner account login.

HETZNER_ROBOT_USER=your-webservice-username
HETZNER_ROBOT_PASSWORD=your-webservice-password

# Auction data source
# Default: hosted 15-minute Cloudflare cache
# Set to "direct" to bypass the hosted cache and fetch from Hetzner.
# HCTL_AUCTION_SOURCE=direct
# HCTL_AUCTION_CACHE_URL=https://auction.hctl.dev

# Legacy aliases for the auction source variables above (still honored).
# HETZNER_CLI_AUCTION_SOURCE=direct
# HETZNER_CLI_AUCTION_CACHE_URL=https://auction.hctl.dev

# Hetzner Cloud API token
# Get from: https://console.hetzner.cloud/projects (Security > API Tokens)
# Optional: prefer `hctl cloud context` for multi-context token storage.
# HETZNER_CLOUD_TOKEN=your-hcloud-token
